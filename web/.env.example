# Copy to .env.local and fill in. Never commit .env.local.

# Firebase web app config (Firebase console → Project settings → Your apps → Web app).
# These are not secrets, but keep them out of git anyway.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Local development against the Firebase emulator (no real project needed):
#   VITE_FIREBASE_API_KEY=demo-key
#   VITE_FIREBASE_AUTH_DOMAIN=demo-baki.firebaseapp.com
#   VITE_FIREBASE_PROJECT_ID=demo-baki
#   VITE_FIREBASE_APP_ID=demo-app
#   VITE_USE_EMULATOR=true
VITE_USE_EMULATOR=false
# The owner's user UID (staff are everyone else with a staff record). With the emulator use
# REPLACE_WITH_OWNER_UID (the seed's test owner). `npm run deploy` sets it from OWNER_UID.
VITE_OWNER_UID=
# Change to your computer's LAN IP to test from a phone on the same Wi-Fi.
VITE_EMULATOR_HOST=127.0.0.1

# ---- Deploy (npm run deploy) — put these in web/.env.deploy.local, never commit it ----
# VITE_FIREBASE_API_KEY=…            (Firebase console → Project settings → Your apps → Web app)
# VITE_FIREBASE_AUTH_DOMAIN=…
# VITE_FIREBASE_PROJECT_ID=…
# VITE_FIREBASE_APP_ID=…
# VITE_USE_EMULATOR=false
# OWNER_UID=…                        (Authentication → Users → the owner's User UID; used only in the rules)
# HOSTING_SITES=medibooks,…           (Hosting sites that serve the app, main link first; default: the project id)
